instances/

# The Tor Expert Bundle itself — downloaded automatically now (see torDownload.ts) or fetched by
# hand per windows/README.md / mac/README.md. Never redistribute a copy of it in this repo.
windows/tor/*.exe
windows/tor/*.dll
windows/tor/pluggable_transports/
mac/tor/tor
mac/tor/*.dylib
mac/tor/pluggable_transports/
