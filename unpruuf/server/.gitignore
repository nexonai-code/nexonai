node_modules/
dist/
build/
relay.sqlite
relay.sqlite-*
*.log

# Generated at runtime (Windows path) — never ship a real auth token or the Tor identity keys.
relay-identity.json
torrc
tor-hidden-service/
tor-data/

# Second-relay-for-testing instances (see mac/start-relay-b.command) — same sensitive runtime
