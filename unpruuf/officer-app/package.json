{
  "name": "unpruuf-officer-app",
  "version": "0.1.0",
  "private": true,
  "description": "Compliance-officer client + case-management dashboard for unpruuf Whistleblower (GRAL architecture). A real Double-Ratchet peer, byte-for-byte wire-compatible with the Android app — not a variant of the blind relay in ../server/.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
