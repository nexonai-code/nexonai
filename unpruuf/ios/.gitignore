DerivedData/

# CocoaPods (generated locally via `pod install`, never committed)
Pods/
Podfile.lock

# Swift Package Manager
.build/
.swiftpm/
.swiftpm-build/

# Xcode-generated Info.plist / build products
*.xcframework/
*.app/
*.ipa

.DS_Store
