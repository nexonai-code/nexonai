<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- unpruuf Business target (Node-Mesh). Same sources as the other two apps; this file
	     (UnpruufEdition = business), the bundle id and the display name differ. See README.md. -->
	<!-- Matches the Android app's versioning scheme (see unpruuf/app/build.gradle.kts /
	     STATUS.md's "Versioning" section, and SettingsView.swift, which reads this back out) —
	     keep CFBundleShortVersionString in step with Android's versionName ("1.01", "1.02", ...)
	     on every delivery that touches app behavior on either platform. -->
	<key>CFBundleShortVersionString</key>
	<string>1.01</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UnpruufEdition</key>
	<string>business</string>
	<key>CFBundleDisplayName</key>
	<string>unpruuf Business</string>
	<key>NSCameraUsageDescription</key>
	<string>Camera: pentru a scana coduri QR de asociere și de server. Nu se înregistrează și nu se stochează nimic. / Used to scan pairing and server QR codes. Nothing is recorded or stored.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID: pentru a debloca aplicația în loc de PIN. Nu se stochează nimic. / Used to unlock the app instead of typing your PIN. Nothing is stored.</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
