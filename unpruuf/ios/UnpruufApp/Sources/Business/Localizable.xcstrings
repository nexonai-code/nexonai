          }
        }
      }
    },
    "The license expired on %@. Enter a renewal code to continue.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Licența a expirat pe %@. Introdu un cod de reînnoire pentru a continua."
          }
        }
      }
    },
    "The node list cannot be read on this phone. It is left untouched.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de noduri nu poate fi citită pe acest telefon. Rămâne neatinsă."
          }
        }
      }
    },
    "The nodes leave this phone. The servers do not change.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodurile dispar de pe acest telefon. Serverele nu se schimbă."
          }
        }
      }
    },
    "The server restarted. Unlock it only if it is yours. If in doubt, set up a new server.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul a repornit. Deblochează-l doar dacă este al tău. Dacă ai dubii, configurează un server nou."
          }
        }
      }
    },
    "This code was already used. Open this screen again for a new one.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cod a fost deja folosit. Deschide din nou ecranul pentru un cod nou."
          }
        }
      }
    },
    "This contact's key has changed. It was not added.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia acestui contact s-a schimbat. Nu a fost adăugat."
          }
        }
      }
    },
    "This invitation can only be accepted in the free Client app.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această invitație poate fi acceptată doar în aplicația gratuită Client."
          }
        }
      }
    },
    "This is a Pro Groups code, it can only be added in the Pro Groups app.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este un cod Pro Groups și poate fi adăugat doar în aplicația Pro Groups."
          }
        }
      }
    },
    "This is a reporting code, it can't be added here.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este un cod de raportare și nu poate fi adăugat aici."
