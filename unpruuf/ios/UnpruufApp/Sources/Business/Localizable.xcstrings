    "Set a PIN to open the app and a separate panic PIN. Entering the panic PIN instantly deletes all contacts and opens the app empty.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilește un cod PIN pentru a deschide aplicația și un cod PIN de panică separat. Introducerea codului PIN de panică șterge instantaneu toate contactele și deschide aplicația goală."
          }
        }
      }
    },
