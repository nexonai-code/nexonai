    "Messages wait on the sender's servers for the lifetime they chose (at most 24 h). Open the app to receive. Cover traffic runs only while the app is open.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajele așteaptă pe serverele expeditorului cât a ales acesta (cel mult 24 de ore). Deschide aplicația ca să le primești. Traficul de acoperire rulează doar cât aplicația este deschisă."
          }
        }
      }
    },
