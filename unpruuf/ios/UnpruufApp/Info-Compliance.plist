<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- unpruuf Compliance (Whistleblower) target. Same sources as the consumer app; only this file
	     (UnpruufEdition = compliance), the bundle id and the display name differ — see README.md,
	     "unpruuf Compliance". The edition badge is deliberately NOT shown anywhere in the app and the
	     display name stays a plain "unpruuf", so the app looks like any other messenger. -->
	<!-- Matches the Android app's versioning scheme (see unpruuf/app/build.gradle.kts /
	     STATUS.md's "Versioning" section, and SettingsView.swift, which reads this back out) —
	     keep CFBundleShortVersionString in step with Android's versionName ("1.01", "1.02", ...)
	     on every delivery that touches app behavior on either platform. -->
	<key>CFBundleShortVersionString</key>
	<string>1.01</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UnpruufEdition</key>
	<string>compliance</string>
	<key>CFBundleDisplayName</key>
	<string>unpruuf</string>
	<key>NSCameraUsageDescription</key>
	<string>Camera: pentru a scana codul QR al organizației tale. Nu se înregistrează și nu se stochează nimic. / Used to scan your organisation's QR code. Nothing is recorded or stored.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID: pentru a debloca aplicația în loc de PIN. Nu se stochează nimic. / Used to unlock the app instead of typing your PIN. Nothing is stored.</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
